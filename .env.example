# Copy to .env and fill in. Dummy values only; never commit real secrets.

# Required: Anthropic API key (first called in Phase 3)
ANTHROPIC_API_KEY=sk-ant-replace-me

# Required: ntfy topic (treat as a secret; use a long random string)
NTFY_TOPIC=replace-with-a-long-random-topic
# Optional: self-hosted ntfy server and auth token
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional: PostHog analytics and feature flags (blank = disabled)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional: OTLP trace endpoint (blank = tracing disabled)
OTEL_EXPORTER_OTLP_ENDPOINT=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Database (docker compose)
POSTGRES_USER=holiday
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=holiday
# Use localhost:5432 instead of db:5432 when running pnpm scripts on the host
DATABASE_URL=postgres://holiday:change-me-local-only@db:5432/holiday
